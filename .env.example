# === 蔚小芯 环境配置模板 ===
# 复制为 .env 后填入真实值，.env 已被 .gitignore 忽略

# ---- 服务 ----
APP_PORT=8080
APP_MODE=debug           # debug | release
LOG_LEVEL=info           # debug | info | warn | error

# ---- JWT ----
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRE_HOURS=2

# ---- SQLite ----
SQLITE_PATH=./data/wxx.db

# ---- 智谱清言 API ----
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4

# ---- DeepSeek API ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- 讯飞星火 语音 API ----
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=

# ---- 学工系统对接 ----
XUEGONG_BASE_URL=
XUEGONG_TOKEN=

# ---- 一表通对接 ----
YBT_BASE_URL=
YBT_TOKEN=

# ---- SSO ----
SSO_BASE_URL=
SSO_CALLBACK_URL=http://localhost:8080/api/v1/auth/callback

# ---- 蔚园智答 同步 ----
WEIYUAN_SYNC_SECRET=     # HMAC-SHA256 签名密钥
WEIYUAN_IMPORT_URL=
