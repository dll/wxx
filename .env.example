# === 蔚小芯 环境配置模板 ===
# 复制为 .env 后填入真实值，.env 已被 .gitignore 忽略

# ---- 服务 ----
APP_PORT=8080
APP_MODE=debug           # debug | release
LOG_LEVEL=info           # debug | info | warn | error

# ---- JWT ----
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRE_HOURS=2

# ---- SQLite ----
SQLITE_PATH=./data/wxx.db

# ---- 智谱清言 API ----
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_MODEL=glm-4

# ---- 智谱 GLM-4V（多模态问答）----
ZHIPU_4V_API_KEY=
ZHIPU_4V_MODEL=glm-4v

# ---- DeepSeek API ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-pro

# ---- 讯飞星火 语音 API ----
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_SPEECH_URL=https://iat-api.xfyun.cn/v2/iat

# ---- 学工系统对接 ----
XUEGONG_BASE_URL=
XUEGONG_TOKEN=

# ---- 一表通对接 ----
YBT_BASE_URL=
YBT_TOKEN=

# ---- SSO ----
SSO_BASE_URL=
SSO_CALLBACK_URL=http://localhost:8080/api/v1/auth/callback

# ---- 蔚园智答 同步 ----
WEIYUAN_SYNC_SECRET=     # HMAC-SHA256 签名密钥
WEIYUAN_IMPORT_URL=

# ---- Temporal 工作流引擎 ----
TEMPORAL_HOST_PORT=      # 空 = 禁用（默认），开发: "localhost:7233"
TEMPORAL_NAMESPACE=wxx
TEMPORAL_TASK_QUEUE=wxx-critical

# ---- 微信小程序 ----
WECHAT_APP_ID=
WECHAT_APP_SECRET=
