# 蔚小芯 - 后端配置示例
# 复制此文件为 .env 并根据实际情况修改

# ── 服务配置 ──
APP_PORT=8080
APP_MODE=debug              # debug | release | test
LOG_LEVEL=info              # debug | info | warn | error

# ── JWT 安全 ──
JWT_SECRET=dev-secret-not-for-production-min-32-chars!!
JWT_EXPIRE_HOURS=2

# ── 数据库配置 ──
# 系统自动识别协议选择驱动：
#   - libsql:// 开头 → Turso 云数据库（Vercel 部署必选，数据持久化）
#   - 其他           → 本地 SQLite 文件（本地开发/自托管服务器）
#
# 本地开发（SQLite 文件，数据持久化到本地磁盘）
DB_PATH=./data/wxx.db
#
# Vercel 生产部署（Turso 云数据库，数据持久化到云端）
# 1. 在 https://turso.tech 注册并创建数据库
# 2. 获取数据库 URL 和 Auth Token
# 3. 在 Vercel 环境变量中设置 DB_PATH 为下方格式
# DB_PATH=libsql://wxx-agent.turso.io?authToken=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...

# ── LLM API 密钥（至少配置一个）──
ZHIPU_API_KEY=your-zhipu-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
XFYUN_APP_ID=your-xfyun-app-id
XFYUN_API_KEY=your-xfyun-api-key
XFYUN_API_SECRET=your-xfyun-api-secret

# ── 学工系统对接（可选）──
XUEGONG_BASE_URL=https://xuegong.example.com
XUEGONG_TOKEN=your-xuegong-token

# ── 一表通对接（可选）──
YBT_BASE_URL=https://ybt.example.com
YBT_TOKEN=your-ybt-token

# ── SSO 对接（可选）──
SSO_BASE_URL=https://sso.example.com
SSO_CALLBACK_URL=http://localhost:8080/api/v1/auth/callback

# ── 通知推送（可选）──
QQ_WEBHOOK_URL=https://qunqun.api.qq.com/cgi-bin/webhook/send?key=your-key
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key

# ── CORS ──
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://wxx-agent.online,https://www.wxx-agent.online
