# 蔚小芯 - 后端配置示例
# 复制此文件为 .env 并根据实际情况修改

# ── 服务配置 ──
APP_PORT=8080
APP_MODE=debug              # debug | release | test
LOG_LEVEL=info              # debug | info | warn | error

# ── JWT 安全 ──
JWT_SECRET=dev-secret-not-for-production-min-32-chars!!
JWT_EXPIRE_HOURS=2

# ── 数据库配置 ──
# 本地开发使用 SQLite 文件数据库
# DB_PATH=./data/wxx.db

# Turso 云数据库（推荐用于测试/生产）
# DB_PATH=libsql://wxx-agent.turso.io?authToken=<your-token>

# ── LLM API 密钥（至少配置一个）──
ZHIPU_API_KEY=your-zhipu-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
XFYUN_APP_ID=your-xfyun-app-id
XFYUN_API_KEY=your-xfyun-api-key
XFYUN_API_SECRET=your-xfyun-api-secret

# ── 学工系统对接（可选）──
XUEGONG_BASE_URL=https://xuegong.example.com
XUEGONG_TOKEN=your-xuegong-token

# ── 一表通对接（可选）──
YBT_BASE_URL=https://ybt.example.com
YBT_TOKEN=your-ybt-token

# ── SSO 对接（可选）──
SSO_BASE_URL=https://sso.example.com
SSO_CALLBACK_URL=http://localhost:8080/api/v1/auth/callback

# ── 通知推送（可选）──
QQ_WEBHOOK_URL=https://qunqun.api.qq.com/cgi-bin/webhook/send?key=your-key
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key

# ── CORS ──
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://wxx-agent.pages.dev
