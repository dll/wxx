# Caddy配置 — 蔚小芯腾讯云集中部署
# 位置: /etc/caddy/Caddyfile
#
# 单一 Caddy 实例同时服务：
#   - /api/*  → Go 后端 (localhost:8080)
#   - /*      → Flutter Web 静态文件 (/opt/wxx/frontend/web)
# 所有请求强制跳转到 www.wxx-agent.online

# 无 www → 有 www 永久重定向
wxx-agent.online {
	redir https://www.wxx-agent.online{uri} permanent
}

www.wxx-agent.online {
	# API 反向代理优先：所有 /api/* 请求转发到 Go 后端，不参与 SPA fallback
	handle /api/* {
		reverse_proxy localhost:8080
	}

	# 其余请求服务静态文件（Flutter Web 构建产物）
	handle {
		root * /opt/wxx/frontend/web

		# SPA 路由回退：未匹配到静态文件的请求返回 index.html
		try_files {path} /index.html

		# 静态文件压缩
		encode zstd gzip
	}

	# 安全头
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# 日志
	log {
		output file /var/log/caddy/wxx.log
		format json
	}
}
