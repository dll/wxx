{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "go build -o bin/wxx-server ./server/cmd/server"
  },
  "deploy": {
    "startCommand": "bin/wxx-server",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "always"
  }
}
